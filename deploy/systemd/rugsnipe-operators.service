# rugsnipe-operators -- hot role (fra1): the daily operator-table refresh (docs/09-operator-wave.md,
# "Keeping the table fresh"), started at 23:50 UTC by rugsnipe-operators.timer.
#
# Rebuilds /etc/rugsnipe/operators.json (0640 root:rugsnipe, written to a tmp file and renamed)
# from the copied wallet's last 24 h on chain over standard JSON-RPC (--source rpc: the TRITON_URL
# line of /etc/rugsnipe/keys/api-keys.toml, else its RPC_URL; getSignaturesForAddress +
# getTransaction, ~1,500 calls at 5 req/s, ~5 min; 2026-10-25: the Helius key is at its usage
# limit), merged with the previous table. Then operator_clock.py (Helius; ~2,000 calls at 4 req/s,
# ~9 min) sets the exit clocks; without Helius credits it fails harmlessly (the - prefix). The keys
# are read at run time and never logged.
#
# THE HOT LOOP READS entry.operators_file ONLY AT START: the new table takes effect through the
# try-restart below (5-20 s; rugsnipe-guard holds the exits meanwhile; nothing is started if
# rugsnipe-hot is not running). A failed or short pull (< 20 round trips) exits non-zero: the old
# table stays and nothing is restarted. Point [entry] operators_file at /etc/rugsnipe/operators.json.
# --source rpc skips his failed attempts and the bundle and dump facts (--drop-dumpers then drops nothing); the bot
# uses hold_slots and stake_tier. docs/13 has a 7-day override (systemctl edit) for the tweet-coin rule.
# Run once by hand:  sudo systemctl start rugsnipe-operators.service; journalctl -u rugsnipe-operators
# Dry run (stdout only):  sudo python3 -I /opt/rugsnipe/src/analysis/scripts/strategy/operators_refresh.py --dry-run
[Unit]
Description=rugsnipe operator table refresh (daily, docs/09)
Documentation=file:/opt/rugsnipe/src/docs/09-operator-wave.md
Wants=network-online.target
After=network-online.target time-sync.target
ConditionPathExists=/etc/rugsnipe/keys/api-keys.toml

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/lib/rugsnipe
Environment=PYTHONUNBUFFERED=1
# 2026-10-28: --copy-signers-seed also writes his launch buys per signer of the same 24 h (the copy counter of
# entry.copy_signer_min_buys, loaded by rugsnipe-hot at start as copy_signers.json beside state.db), so a start after
# downtime does not count from empty (a count started empty keeps 99 of 226 copies over 5 days, docs/17 section 9).
# It is written only while rugsnipe-hot is NOT active (a running hot unit keeps its own counts and saves them at
# shutdown); during a normal 4-hourly refresh the line is a no-op and the journal says so.
ExecStart=/usr/bin/python3 -I /opt/rugsnipe/src/analysis/scripts/strategy/operators_refresh.py --api-keys /etc/rugsnipe/keys/api-keys.toml --source rpc --hours 24 --out /etc/rugsnipe/operators.json --state /var/lib/rugsnipe/state.db --min-n 2 --drop-dumpers --mode 0640 --group rugsnipe --copy-signers-seed /var/lib/rugsnipe/copy_signers.json
# exit clocks (docs/09 "Exit clocks"): signers whose hold rests on < 5 of the wallet's round trips get their own
# sell clock's hold where it beat the wallet's in both halves of their last 48 h of launches; a failure ('-')
# leaves the wallet's holds and still restarts
ExecStartPost=-/usr/bin/python3 -I /opt/rugsnipe/src/analysis/scripts/strategy/operator_clock.py --api-keys /etc/rugsnipe/keys/api-keys.toml --table /etc/rugsnipe/operators.json --mode 0640 --group rugsnipe
ExecStartPost=/bin/systemctl try-restart rugsnipe-hot.service
TimeoutStartSec=45min
Nice=10
UMask=0027

# root only to read the 0700 keys and chown the table; everything but /etc/rugsnipe and /var/lib/rugsnipe is read-only
# (state.db is opened read-only; the only file written under /var/lib/rugsnipe is copy_signers.json, above)
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/rugsnipe /var/lib/rugsnipe
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
